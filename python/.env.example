# Release tokens for the PyPI helper (python/scripts/pypi_release.py).
# This file is a TEMPLATE - the real tokens live in untracked python/.env,
# which git refuses to commit (see .gitignore). Nothing here authenticates.
#
# Mint at https://pypi.org/manage/account/ (and https://test.pypi.org/manage/account/ for
# the dry run). The first publish needs an entire-account token because the
# project does not exist yet; afterwards mint project-scoped tokens and burn
# the first one.
PYPI_TEST_TOKEN=paste-TestPyPI-token-here
PYPI_TOKEN=paste-PyPI-token-here
