{
  "name": "roblox-studio-mcp",
  "version": "0.1.0",
  "description": "A lightweight, dependency-free Node.js/TypeScript client for MCP (Model Context Protocol) servers, with built-in convenience for the Roblox Studio MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./extended": "./dist/extended/index.js"
  },
  "bin": {
    "roblox-studio-mcp-server": "./dist/server.js",
    "roblox-studio-mcp-extended-server": "./dist/extendedServer.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "roblox",
    "roblox-studio",
    "json-rpc",
    "stdio"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
